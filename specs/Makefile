ASCIIDOC ?= asciidoctor
PYTHON ?= python3
SPIRV ?= ../tools/spirv/build/install/bin/spirv

LINKS_CHECK = ../tools/checklinks/checklinks.py

BUILD_HEADERS = ../SPIRV-Headers/tools/buildHeaders
JSON_PATH = ../SPIRV-Headers/include/spirv/unified1/spirv.core.grammar.json

ASCIIDOC_DEBUG_OPTIONS ?= --failure-level=WARN --trace
ASCIIDOC_COMMON_OPTIONS ?= -a ratified_core_spec -a specs=$(CURDIR) -a examples=$(CURDIR)/examples -a images=$(CURDIR)/images $(ASCIIDOC_DEBUG_OPTIONS)
ASCIIDOC_HTML_OPTIONS ?= $(ASCIIDOC_COMMON_OPTIONS) -b html5 -a data-uri -a stylesheet=resources/spirv.css -a sectanchors --safe-mode safe
ASCIIDOC_PDF_OPTIONS ?= $(ASCIIDOC_COMMON_OPTIONS) -b pdf -d book -r asciidoctor-pdf -a pdf-theme=resources/spirv-theme.yml

# PDF optimizer - usage $(OPTIMIZEPDF) in.pdf out.pdf
# OPTIMIZEPDFOPTS=--compress-pages is slightly better, but much slower
OPTIMIZEPDF = hexapdf optimize $(OPTIMIZEPDFOPTS)

# These are the files generated by process_versions.py
AUTO_FILES= auto.intro.adoc auto.intro.author.adoc auto.changes.adoc

SPIRV_FILES=SPIRV.adoc intro.adoc boilerplate.adoc copyright-spec.adoc \
	    specification.adoc binary.adoc changes.adoc \
	    examples/example.frag examples/exampleFragDisassembled.txt \
	    $(AUTO_FILES)
GLSL_FILES=GLSL.std.450.adoc GLSLGenerated.adoc boilerplate.adoc copyright-spec.adoc
OPENCL_FILES=OpenCL.std.adoc OpenCLGenerated.adoc boilerplate.adoc copyright-spec.adoc
DEBUG_INFO_FILES=DebugInfo.adoc boilerplate.adoc copyright-spec.adoc
OPENCL_DEBUG_INFO_FILES=OpenCL.DebugInfo.100.adoc boilerplate.adoc copyright-spec.adoc

ALL_HTMLS=SPIRV.html GLSL.std.450.html OpenCL.std.html \
	  MachineReadableGrammar.html DebugInfo.html OpenCL.DebugInfo.100.html
ALL_PDFS=$(ALL_HTMLS:.html=.pdf)
ALL_DOCS=$(ALL_HTMLS) $(ALL_PDFS)

all: $(ALL_DOCS)

clean:
	rm -f $(ALL_DOCS)
	rm -f binary.adoc GLSLGenerated.adoc OpenCLGenerated.adoc
	rm -f auto.*.adoc unified-version-info

# The file unified-version-info acts as a collective timestamp
# for the recency of the spec fragments that embed title, authorship,
# and version change logs for the SPIR-V core spec.
# It's a single node in the dependency graph so that potentially
# parallel builds will work.
# We keep it around as a file so avoid spurious rebuilds that
# would occur if it were just a phony target.
unified-version-info: version.* bin/process_versions.py
	${PYTHON} bin/process_versions.py
	touch $@

$(AUTO_FILES) : unified-version-info

SPIRV.html: $(SPIRV_FILES)
	touch $<
	$(ASCIIDOC) $(ASCIIDOC_HTML_OPTIONS) -o $@ $<
	dos2unix $@ 2> /dev/null

SPIRV.pdf: $(SPIRV_FILES)
	$(ASCIIDOC) $(ASCIIDOC_PDF_OPTIONS) -o $@ $<
	$(OPTIMIZEPDF) $@ $@.out.pdf && mv $@.out.pdf $@

binary.adoc: $(SPIRV) $(JSON_PATH)
	$(SPIRV) -p $(JSON_PATH) > binary.adoc
	dos2unix $@ 2> /dev/null

GLSLGenerated.adoc: $(SPIRV)
	$(SPIRV) -s GLSL $(JSON_PATH) > $@
	dos2unix $@ 2> /dev/null

GLSL.std.450.html: $(GLSL_FILES)
	$(ASCIIDOC) $(ASCIIDOC_HTML_OPTIONS) -o $@ $<
	dos2unix $@ 2> /dev/null

GLSL.std.450.pdf: $(GLSL_FILES)
	$(ASCIIDOC) $(ASCIIDOC_PDF_OPTIONS) -o $@ $<
	$(OPTIMIZEPDF) $@ $@.out.pdf && mv $@.out.pdf $@

OpenCLGenerated.adoc: $(SPIRV)
	$(SPIRV) -s OpenCL $(JSON_PATH) > $@
	dos2unix $@ 2> /dev/null

OpenCL.std.html: $(OPENCL_FILES)
	$(ASCIIDOC) $(ASCIIDOC_HTML_OPTIONS) -o $@ $<
	dos2unix $@ 2> /dev/null

OpenCL.std.pdf: $(OPENCL_FILES)
	$(ASCIIDOC) $(ASCIIDOC_PDF_OPTIONS) -o $@ $<
	$(OPTIMIZEPDF) $@ $@.out.pdf && mv $@.out.pdf $@

### Debug info
DebugInfo.html: $(DEBUG_INFO_FILES)
	$(ASCIIDOC) $(ASCIIDOC_HTML_OPTIONS) -o $@ $<
	dos2unix $@ 2> /dev/null

DebugInfo.pdf: $(DEBUG_INFO_FILES)
	$(ASCIIDOC) $(ASCIIDOC_PDF_OPTIONS) -o $@ $<
	$(OPTIMIZEPDF) $@ $@.out.pdf && mv $@.out.pdf $@

### OpenCL.DebugInfo.100
OpenCL.DebugInfo.100.html: $(OPENCL_DEBUG_INFO_FILES)
	$(ASCIIDOC) $(ASCIIDOC_HTML_OPTIONS) -o $@ $<
	dos2unix $@ 2> /dev/null

OpenCL.DebugInfo.100.pdf: $(OPENCL_DEBUG_INFO_FILES)
	$(ASCIIDOC) $(ASCIIDOC_PDF_OPTIONS) -o $@ $<
	$(OPTIMIZEPDF) $@ $@.out.pdf && mv $@.out.pdf $@

### Headers
headers: $(BUILD_HEADERS) $(JSON_PATH)
	cd $(BUILD_HEADERS) && bin/makeHeaders

MachineReadableGrammar.html: MachineReadableGrammar.adoc
	$(ASCIIDOC) $(ASCIIDOC_HTML_OPTIONS) -o $@ $<
	dos2unix $@ 2> /dev/null

MachineReadableGrammar.pdf: MachineReadableGrammar.adoc
	$(ASCIIDOC) $(ASCIIDOC_PDF_OPTIONS) -o $@ $<

html: $(ALL_HTMLS)
pdf: $(ALL_PDFS)

# Python prerequisites are now installed in the Docker image used in
# ../.gitlab-ci.yml
check:
	$(PYTHON) $(LINKS_CHECK) $(ALL_HTMLS)
