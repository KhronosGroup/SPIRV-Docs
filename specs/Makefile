ASCIIDOC ?= asciidoctor
PYTHON ?= python3
SPIRV ?= ../tools/spirv/build/install/bin/spirv

LINKS_CHECK = ../tools/checklinks/checklinks.py

BUILD_HEADERS = ../SPIRV-Headers/tools/buildHeaders
JSON_PATH = ../SPIRV-Headers/include/spirv/unified1/spirv.core.grammar.json

ASCIIDOC_DEBUG_OPTIONS ?= --failure-level=WARN --trace
ASCIIDOC_COMMON_OPTIONS ?= -a ratified_core_spec -a specs=$(CURDIR) -a examples=$(CURDIR)/examples -a images=$(CURDIR)/images $(ASCIIDOC_DEBUG_OPTIONS)
ASCIIDOC_HTML_OPTIONS ?= $(ASCIIDOC_COMMON_OPTIONS) -b html5 -a data-uri -a nofooter -a stylesheet=resources/spirv.css -a sectanchors --safe-mode safe
ASCIIDOC_PDF_OPTIONS ?= $(ASCIIDOC_COMMON_OPTIONS) -b pdf -d book -r asciidoctor-pdf -a pdf-theme=resources/spirv-theme.yml

# PDF optimizer - usage $(OPTIMIZEPDF) in.pdf out.pdf
# OPTIMIZEPDFOPTS=--compress-pages is slightly better, but much slower
OPTIMIZEPDF = hexapdf optimize $(OPTIMIZEPDFOPTS)

# These are the files generated by process_versions.py
AUTO_FILES= auto.version.adoc auto.intro.author.adoc auto.changes.adoc

SPIRV_FILES=SPIRV.adoc intro.adoc boilerplate.adoc copyright-spec.adoc \
	    specification.adoc binary.adoc changes.adoc \
	    examples/example.frag examples/exampleFragDisassembled.txt \
	    $(AUTO_FILES)
GLSL_FILES=GLSL.std.450.adoc GLSLGenerated.adoc boilerplate.adoc copyright-spec.adoc
OPENCL_FILES=OpenCL.std.adoc OpenCLGenerated.adoc boilerplate.adoc copyright-spec.adoc
DEBUG_INFO_FILES=DebugInfo.adoc boilerplate.adoc copyright-spec.adoc
OPENCL_DEBUG_INFO_FILES=OpenCL.DebugInfo.100.adoc boilerplate.adoc copyright-spec.adoc

ALL_HTMLS=SPIRV.html GLSL.std.450.html OpenCL.std.html \
	  MachineReadableGrammar.html DebugInfo.html OpenCL.DebugInfo.100.html
ALL_PDFS=$(ALL_HTMLS:.html=.pdf)
ALL_DOCS=$(ALL_HTMLS) $(ALL_PDFS)

all: $(ALL_DOCS)

clean:
	rm -f $(ALL_DOCS)
	rm -f binary.adoc GLSLGenerated.adoc OpenCLGenerated.adoc
	rm -f auto.*.adoc unified-version-info

# The file unified-version-info acts as a collective timestamp
# for the recency of the spec fragments that embed title, authorship,
# and version change logs for the SPIR-V core spec.
# It's a single node in the dependency graph so that potentially
# parallel builds will work.
# We keep it around as a file so avoid spurious rebuilds that
# would occur if it were just a phony target.
unified-version-info: version.* bin/process_versions.py
	${PYTHON} bin/process_versions.py
	touch $@

$(AUTO_FILES) : unified-version-info

SPIRV.html: $(SPIRV_FILES)
	touch $<
	$(ASCIIDOC) $(ASCIIDOC_HTML_OPTIONS) -o $@ $<
	dos2unix $@ 2> /dev/null

SPIRV.pdf: $(SPIRV_FILES)
	$(ASCIIDOC) $(ASCIIDOC_PDF_OPTIONS) -o $@ $<
	$(OPTIMIZEPDF) $@ $@.out.pdf && mv $@.out.pdf $@

binary.adoc: $(SPIRV) $(JSON_PATH)
	$(SPIRV) -p $(JSON_PATH) > binary.adoc
	dos2unix $@ 2> /dev/null

GLSLGenerated.adoc: $(SPIRV)
	$(SPIRV) -s GLSL $(JSON_PATH) > $@
	dos2unix $@ 2> /dev/null

GLSL.std.450.html: $(GLSL_FILES)
	$(ASCIIDOC) $(ASCIIDOC_HTML_OPTIONS) -o $@ $<
	dos2unix $@ 2> /dev/null

GLSL.std.450.pdf: $(GLSL_FILES)
	$(ASCIIDOC) $(ASCIIDOC_PDF_OPTIONS) -o $@ $<
	$(OPTIMIZEPDF) $@ $@.out.pdf && mv $@.out.pdf $@

OpenCLGenerated.adoc: $(SPIRV)
	$(SPIRV) -s OpenCL $(JSON_PATH) > $@
	dos2unix $@ 2> /dev/null

OpenCL.std.html: $(OPENCL_FILES)
	$(ASCIIDOC) $(ASCIIDOC_HTML_OPTIONS) -o $@ $<
	dos2unix $@ 2> /dev/null

OpenCL.std.pdf: $(OPENCL_FILES)
	$(ASCIIDOC) $(ASCIIDOC_PDF_OPTIONS) -o $@ $<
	$(OPTIMIZEPDF) $@ $@.out.pdf && mv $@.out.pdf $@

### Debug info
DebugInfo.html: $(DEBUG_INFO_FILES)
	$(ASCIIDOC) $(ASCIIDOC_HTML_OPTIONS) -o $@ $<
	dos2unix $@ 2> /dev/null

DebugInfo.pdf: $(DEBUG_INFO_FILES)
	$(ASCIIDOC) $(ASCIIDOC_PDF_OPTIONS) -o $@ $<
	$(OPTIMIZEPDF) $@ $@.out.pdf && mv $@.out.pdf $@

### OpenCL.DebugInfo.100
OpenCL.DebugInfo.100.html: $(OPENCL_DEBUG_INFO_FILES)
	$(ASCIIDOC) $(ASCIIDOC_HTML_OPTIONS) -o $@ $<
	dos2unix $@ 2> /dev/null

OpenCL.DebugInfo.100.pdf: $(OPENCL_DEBUG_INFO_FILES)
	$(ASCIIDOC) $(ASCIIDOC_PDF_OPTIONS) -o $@ $<
	$(OPTIMIZEPDF) $@ $@.out.pdf && mv $@.out.pdf $@

### Headers
headers: $(BUILD_HEADERS) $(JSON_PATH)
	cd $(BUILD_HEADERS) && bin/makeHeaders

MachineReadableGrammar.html: MachineReadableGrammar.adoc
	$(ASCIIDOC) $(ASCIIDOC_HTML_OPTIONS) -o $@ $<
	dos2unix $@ 2> /dev/null

MachineReadableGrammar.pdf: MachineReadableGrammar.adoc
	$(ASCIIDOC) $(ASCIIDOC_PDF_OPTIONS) -o $@ $<

html: $(ALL_HTMLS)
pdf: $(ALL_PDFS)

# Python prerequisites are now installed in the Docker image used in
# ../.gitlab-ci.yml
check:
	$(PYTHON) $(LINKS_CHECK) $(ALL_HTMLS)

# Antora conversion
SCRIPTS   = $(CURDIR)/scripts
MKDIR     = mkdir -p

HTMLDIR   = .
GENERATED = generated
PYXREFMAP = $(GENERATED)/xrefMap.py
JSXREFMAP = $(GENERATED)/xrefMap.cjs
JSPAGEMAP = $(GENERATED)/pageMap.cjs
PYPAGEMAP = $(GENERATED)/pageMap.py

# Cross-references of anchors to spec chapters they lie within
# Used both by Antora and validusage_page targets

xrefMap: $(PYXREFMAP) $(JSXREFMAP)

#@ Need to handle multiple SPIR-V specs, eventually
$(PYXREFMAP) $(JSXREFMAP): $(HTMLDIR)/SPIRV.html
	$(MKDIR) $(GENERATED)
	$(PYTHON) $(SCRIPTS)/map_html_anchors.py \
	    $(HTMLDIR)/SPIRV.html -pyfile $(PYXREFMAP) -jsfile $(JSXREFMAP)

# Generate all Antora module content
# After the targets are built, the $(JSXREFMAP) and $(JSPAGEMAP) files
# used by spec macros in the Antora build must be copied into the Antora
# project build tree, which is in a different repository.

#@ setup_features_antora setup_refpages_antora
setup_antora: xrefMap .WAIT setup_spirv_antora

# Generate Antora spec module content by rewriting spec sources
# Individual files must be specified last
# This target is also used to generate the pageMap, which is combined
# with the xrefMap above to map VUID anchors into the Antora pages they
# are found within.

ANTORA_SPECMODULE = antora/spec/modules/spirv

# The list of files is long enough to exceed system limits on argument
# lists, so instead of passing them on the command line they are stored
# in a separate file.
ANTORA_FILELIST = $(GENERATED)/antoraFileList.txt

# Additional individual files to include - config (copyright), attributes, images, etc.
ANTORA_EXTRAFILES = \
	./images/*.svg \
	$(JSXREFMAP) \
	$(JSAPIMAP)

# The pageMap is copied, separately since antora-prep.py creates it.
#@ deps: $(JSAPIMAP)
#@        cp $(JSPAGEMAP) $(ANTORA_SPECMODULE)/partials/$(GENERATED_DIR)
setup_spirv_antora pageMap $(JSPAGEMAP) $(PYPAGEMAP): xrefMap spirv_nav_antora
	ls -1 [A-Za-z]*.adoc $(ANTORA_EXTRAFILES) > $(ANTORA_FILELIST)
	$(PYTHON) $(SCRIPTS)/antora-prep.py \
	    -root . \
	    -component $(shell realpath $(ANTORA_SPECMODULE)) \
	    -pageHeaders antora/pageHeaders-spirv.adoc \
	    -xrefMap $(PYXREFMAP) \
	    -module 'spirv::' \
	    -jspagemap $(JSPAGEMAP) \
	    -pypagemap $(PYPAGEMAP) \
	    -filelist $(ANTORA_FILELIST)

# Construct the spec component nav.adoc from the list of included
# chapters in vkspec.adoc, so it remains up to date.
# This is a simple transformation turning include directives into xrefs.
# Unfortunately we cannot set or use attributes in nav files, so the
#   {chapters} and {appendices} attributes must be turned into hardcoded
#   paths in the pages/ directory.
SPECSRC = SPIRV.adoc
SPECNAV = $(ANTORA_SPECMODULE)/nav.adoc
spirv_nav_antora: $(SPECSRC)
	cat $(SPECSRC) | \
	    sed -n '/tag::antora-vulkan-nav/,/end::antora-vulkan-nav/p' | \
	    egrep '^include::' | \
	    tr -d '{}' | \
	    sed -e 's/include::/* xref:/' > $(SPECNAV)

# Clean generated and output files

# Files generated by 'setup_antora' target
# Omit
#   antora/<module>/modules/<module>/nav.adoc
# and
#   antora/<module>/modules/<module>/pages/index.adoc
# also checked in.
CLEAN_ANTORA_PATHS = \
	$(ANTORA_FILELIST) \
	antora/spec/modules/spirv/nav.adoc \
	antora/spec/modules/spirv/images \
	antora/spec/modules/spirv/pages/*.adoc \
	antora/spec/modules/spirv/partials \
	antora/spec/modules/spirv/pages/$(GENERATED_DIR) \
	antora/spec/modules/spirv/partials \
	$(JSXREFMAP) \
	$(PYXREFMAP) \
	$(JSPAGEMAP) \
	$(PYPAGEMAP)

clean_antora:
	rm -rf $(CLEAN_ANTORA_PATHS)

